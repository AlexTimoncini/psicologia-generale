graph TD
    DIL["NATURA O CULTURA?<br/>l'unicità dell'individuo<br/>= COMPONENTE BIOLOGICA<br/>+ COMPONENTE AMBIENTALE<br/>in interazione CIRCOLARE"]

    DIL ==> FIL["FILOGENESI<br/>la storia evolutiva della specie"]

    FIL --> DAR["DARWIN, XIX secolo"]
    DAR --> EVO["EVOLUZIONE<br/>cambiamento PROGRESSIVO<br/>nella FREQUENZA con cui<br/>certe caratteristiche si<br/>manifestano in una POPOLAZIONE<br/>= definizione STATISTICA"]
    DAR --> SEL["SELEZIONE NATURALE<br/>l'adattamento all'ambiente<br/>permette di RIPRODURSI<br/>con più successo"]

    SEL --> FRI["I FRINGUELLI DELLE GALÁPAGOS<br/>antenato comune<br/>isole con risorse diverse<br/>→ becchi diversi"]
    SEL --> GIR["LA GIRAFFA<br/>CORRETTO: sopravvivevano<br/>quelli che GIÀ avevano<br/>il collo più lungo<br/>SBAGLIATO (Lamarck):<br/>lo allungavano e lo trasmettevano"]

    FIL ==> SNC["L'EVOLUZIONE DEL SNC<br/>da unicellulari e platelminti<br/>ai vertebrati<br/>organizzazione GERARCHICA<br/>= estensioni successive"]

    SNC ==> ADA["LE 3 FORME DI ADATTAMENTO"]
    ADA --> BIP["1. BIPEDISMO<br/>→ DEFLESSIONE del SNC<br/>→ arti liberi → UTENSILI<br/>→ azione sull'ambiente"]
    ADA --> ENC["2. ENCEFALIZZAZIONE<br/>sapiens = 3x l'erectus<br/>MA grande ≠ intelligente<br/>NEANDERTHAL aveva un cervello<br/>simile e si è ESTINTO"]
    ADA --> LIN["3. COMPARSA DEL LINGUAGGIO<br/>→ EVOLUZIONE CULTURALE"]

    DIL ==> GEN["LA GENETICA<br/>trasmissione dei caratteri<br/>dai genitori ai figli"]

    GEN --> MEN["MENDEL, metà XIX sec.<br/>piante di pisello<br/>fattori VISIBILI e LATENTI"]

    MEN ==> GF["GENOTIPO + AMBIENTE = FENOTIPO"]
    GF --> GT["GENOTIPO<br/>corredo genetico<br/>presente dal CONCEPIMENTO"]
    GF --> FT["FENOTIPO<br/>i caratteri MANIFESTI"]

    GEN ==> SCA["LA SCALA<br/>base azotata → nucleotide<br/>→ codone (3 nucleotidi<br/>= 1 amminoacido)<br/>→ gene (= 1 proteina)<br/>→ cromosoma → cariotipo"]
    SCA --> BAS["4 BASI: adenina · timina<br/>citosina · guanina"]
    SCA --> CAR["CARIOTIPO = 23 COPPIE<br/>22 AUTOSOMI (geni corrispondenti)<br/>+ 1 coppia SESSUALE<br/>XX femmine · XY maschi"]
    CAR --> GAM["GAMETI per MEIOSI<br/>corredo APLOIDE<br/>fecondazione → ZIGOTE"]

    GEN ==> ALL["GLI ALLELI<br/>forme alternative di un gene"]
    ALL --> DOM["DOMINANTE<br/>si manifesta in OMOZIGOSI (BB)<br/>E in ETEROZIGOSI (Bb)"]
    ALL --> REC["RECESSIVO<br/>si manifesta SOLO<br/>in OMOZIGOSI (bb)"]
    ALL --> POL["POLIGENICO<br/>la MAGGIOR PARTE dei caratteri<br/>es. il COLORE DEGLI OCCHI"]
    REC -.-> PAT["EMOFILIA: X-linked recessiva<br/>FIBROSI CISTICA: autosomica recessiva"]

    GEN --> HGP["HUMAN GENOME PROJECT<br/>avviato 1990 · mappa dal 2003<br/>~25.000 geni<br/>etnie umane uguali al 99,9%<br/>uomo/topo uguali al 99%<br/>80% dei geni attivi nel cervello"]

    DIL ==> GCO["LA GENETICA DEL COMPORTAMENTO<br/>come ereditarietà e ambiente<br/>influenzano le caratteristiche<br/>PSICOLOGICHE"]

    GCO ==> CON["CONCORDANZA<br/>compresenza di una caratteristica<br/>in persone diverse"]

    GCO --> FAM["STUDI DI FAMIGLIA"]
    GCO --> ADO["STUDI SULLE ADOZIONI<br/>biologici = geni senza ambiente<br/>adottivi = ambiente senza geni"]
    GCO --> GEM["STUDI SUI GEMELLI<br/>OMOZIGOTI: 1 zigote diviso<br/>= patrimonio IDENTICO<br/>ETEROZIGOTI: 2 fecondazioni<br/>= come fratelli normali"]
    GEM -.->|"per escludere<br/>l'ambiente condiviso"| SEP["gemelli SEPARATI<br/>nei primissimi mesi"]

    GCO ==> ERE["COEFFICIENTE DI EREDITABILITÀ<br/>da 0 a 1<br/>quota della VARIANZA di una<br/>caratteristica in un GRUPPO<br/>attribuibile a differenze genetiche"]
    ERE -.->|"ATTENZIONE"| ERR["NON dice quanto<br/>in un SINGOLO individuo<br/>quel tratto sia 'dovuto ai geni'<br/>es. religione ≈ 0"]

    DIL ==> SPE["LA GENETICA SPERIMENTALE"]
    SPE --> ART["SELEZIONE ARTIFICIALE<br/>stesso meccanismo della naturale<br/>ma i caratteri li sceglie l'uomo<br/>TRYON 1940: ratti nel labirinto<br/>incrocia i due estremi"]
    SPE --> TRA["ANIMALI TRANSGENICI<br/>KNOCK-OUT = inattiva geni<br/>KNOCK-IN = inserisce geni"]
