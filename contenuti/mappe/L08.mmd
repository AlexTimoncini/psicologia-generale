    STR --> ASS["ASSONE<br/>GENERA e TRASMETTE<br/>fino a 1 metro"]

    SOMA --> NUC["nucleo → DNA<br/>TRASCRIZIONE → RNAm<br/>esce nel citoplasma<br/>TRADUZIONE → proteine"]
    SOMA --> ORG["organelli<br/>ribosomi · reticolo rugoso (restano)<br/>Golgi (escono)<br/>mitocondri → ATP"]

    DEN --> REC["RECETTORI<br/>proteine recettoriali"]
    DEN --> SPI["SPINE DENDRITICHE<br/>aumentano la superficie<br/>→ substrato della PLASTICITÀ"]

    ASS --> CONO["CONO DI EMERGENZA<br/>qui si genera<br/>il potenziale d'azione"]
