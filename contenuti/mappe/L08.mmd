graph TD
    SN["IL SISTEMA NERVOSO<br/>due tipi di cellule"]
    SN ==> GLIA["CELLULE GLIALI<br/>10 volte più numerose"]
    SN ==> NEU["NEURONI<br/>le cellule FUNZIONALI<br/>migliaia di miliardi"]

    GLIA --> G1["1. FUNZIONE STRUTTURALE<br/>impalcatura che tiene<br/>i neuroni in situ<br/>ASTROCITI"]
    GLIA --> G2["2. FUNZIONE METABOLICA<br/>nutrono (sostanze trofiche)<br/>ed eliminano i detriti<br/>OLIGODENDROCITI = mielina"]

    NEU ==> CAR["LE 4 CARATTERISTICHE"]
